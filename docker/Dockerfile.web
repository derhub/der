# syntax=docker/dockerfile:1.7

FROM oven/bun:1@sha256:3aa040e5445efa09d75bb428a64ba50db13e2b3ac9b6b0c7f145615f62b2ee18 AS web-builder

WORKDIR /app

COPY package.json bun.lock tsconfig.json vite.config.ts ./
COPY packages/domain/package.json packages/domain/package.json
COPY packages/storage/package.json packages/storage/package.json
COPY packages/runtime/package.json packages/runtime/package.json
COPY integrations/mcp/package.json integrations/mcp/package.json
COPY apps/server/package.json apps/server/package.json
COPY apps/web/package.json apps/web/package.json

RUN bun install --frozen-lockfile

COPY packages/domain/ packages/domain/
COPY apps/web/ apps/web/

RUN bunx vp -C apps/web build

FROM nginxinc/nginx-unprivileged:1.27-alpine AS der-web

COPY docker/web.conf /etc/nginx/conf.d/default.conf
COPY --from=web-builder /app/apps/web/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=10 \
  CMD ["wget", "-qO-", "http://127.0.0.1:8080/healthz"]
