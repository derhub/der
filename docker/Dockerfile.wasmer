# syntax=docker/dockerfile:1.7

FROM oven/bun:1@sha256:3aa040e5445efa09d75bb428a64ba50db13e2b3ac9b6b0c7f145615f62b2ee18 AS der-wasmer-runner

ARG WASMER_BASH_SHA256=059606d132e2e6bc1afe3b432ee64dcb1b1b059815c8bb213cf3b24798ef21e1
ARG WASMER_BASH_URL=https://cdn.wasmer.io/webcimages/059606d132e2e6bc1afe3b432ee64dcb1b1b059815c8bb213cf3b24798ef21e1.webc
ARG WASMER_PYTHON_SHA256=a9fa8202f1bf6a4eca8d31ee5f2b1970c8f45af5c5520cc954d28a133333d8e7
ARG WASMER_PYTHON_URL=https://cdn.wasmer.io/webcimages/a9fa8202f1bf6a4eca8d31ee5f2b1970c8f45af5c5520cc954d28a133333d8e7.webc

WORKDIR /app

COPY package.json bun.lock tsconfig.json ./
COPY packages/domain/package.json packages/domain/package.json
COPY packages/storage/package.json packages/storage/package.json
COPY packages/runtime/package.json packages/runtime/package.json
COPY integrations/mcp/package.json integrations/mcp/package.json
COPY apps/server/package.json apps/server/package.json
COPY apps/web/package.json apps/web/package.json

RUN bun install --frozen-lockfile

COPY packages/domain/ packages/domain/
COPY packages/runtime/ packages/runtime/
COPY docker/wasmer-runner.ts /app/docker/wasmer-runner.ts
RUN ln -s /app/docker/wasmer-runner.ts /app/wasmer-runner.ts

RUN mkdir -p /guests/cache /work \
  && bun -e 'async function dl(url: string, dest: string) { const res = await fetch(url); if (!res.ok) throw new Error(`${url}: HTTP ${res.status}`); await Bun.write(dest, new Uint8Array(await res.arrayBuffer())); } await Promise.all([dl(process.env["WASMER_BASH_URL"]!, "/guests/bash-1.0.25.webc"), dl(process.env["WASMER_PYTHON_URL"]!, "/guests/python-3.13.20.webc")]);' \
  && printf '%s  /guests/bash-1.0.25.webc\n%s  /guests/python-3.13.20.webc\n' "${WASMER_BASH_SHA256}" "${WASMER_PYTHON_SHA256}" | sha256sum -c - \
  && ln -s /guests/python-3.13.20.webc /guests/python-3.12.2.webc \
  && (cd /app/packages/runtime && bun -e 'import { Wasmer } from "@wasmer/sdk/node"; const client = await Wasmer.create({ cache: { directory: "/guests/cache" } }); try { await client.packages.load("wasmer/bash@1.0.25"); await client.packages.load("python/python@3.13.20"); } finally { await client.close(); }') \
  && chmod -R a+rX /guests \
  && chown -R 1000:1000 /app /work

USER 1000:1000

ENV DER_WASMER_ALLOWED_ROOTS=/work

ENTRYPOINT ["bun", "run", "/app/wasmer-runner.ts"]
